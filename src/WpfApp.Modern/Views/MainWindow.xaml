<Window x:Class="WpfApp.Modern.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1000"
        Height="520">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Id" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,12,0" />
            <TextBlock Text="Department" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Width="120" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Publish EmployeeUpdated (Legacy)"
                    Command="{Binding PublishEmployeeUpdatedCommand}"
                    Padding="8,4" />
            <Button Content="Publish EmployeeSaved (Modern)"
                    Command="{Binding PublishEmployeeSavedCommand}"
                    Padding="8,4"
                    Margin="8,0,0,0" />
            <Button Content="Clear"
                    Command="{Binding ClearCommand}"
                    Padding="8,4"
                    Margin="8,0,0,0" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Messages}" FontFamily="Consolas" />
    </DockPanel>
</Window>
