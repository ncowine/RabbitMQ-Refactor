<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A modern WPF app with no Prism at all: the .NET Generic Host for startup and DI, appsettings.json for configuration,
    CommunityToolkit.Mvvm for view models, and plain message classes on both the Legacy and the Modern bus.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Employees.Contracts\Employees.Contracts.csproj" />
    <ProjectReference Include="..\Messaging\Messaging.Hosting\Messaging.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
