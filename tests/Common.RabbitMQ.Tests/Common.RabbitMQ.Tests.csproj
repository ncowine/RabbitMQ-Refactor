<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Both builds of Common.RabbitMQ share namespaces; each is referenced directly so the alias applies. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Common.RabbitMQ\Common.RabbitMQ.csproj" />
    <ProjectReference Include="..\..\src\Common.Events\Common.Events.csproj" />
    <ProjectReference Include="..\Fixtures\Compat.Events\Compat.Events.csproj" />
    <ProjectReference Include="..\Fixtures\Common.RabbitMQ.Baseline\Common.RabbitMQ.Baseline.csproj" Aliases="baseline" />
    <ProjectReference Include="..\Fixtures\Compat.Events.Baseline\Compat.Events.Baseline.csproj" Aliases="baseline" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Golden\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
